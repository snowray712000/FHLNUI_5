{
  "dependencies": {
    "vite": "^8.0.8"
  },
  "devDependencies": {
    "@fhlnet/color-apple": "^0.3.1",
    "dependency-cruiser": "^18.1.1",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "dev": "vite",
    "build": "node -e \"require('fs').promises.rm('dist',{recursive:true,force:true})\" && vite build",
    "preview": "vite preview --port 5175 --strictPort",
    "depgraph": "depcruise index/index.js --no-config --output-type mermaid --output-to docs/dependency-graph.mmd",
    "test": "vitest run",
    "gen:orig": "node tools/gen_bible_orig.mjs",
    "gen:lxx": "node tools/gen_bible_lxx.mjs",
    "gen:snpos": "node tools/gen_sn_pos.mjs",
    "gen:snmorph": "node tools/gen_sn_morph.mjs",
    "gen:tvm": "node tools/gen_tvm_table.mjs",
    "check:data": "node tools/check_data.mjs",
    "gen:audio": "node tools/gen_audio_bible_index.mjs",
    "gen:uiabv": "node tools/gen_uiabv.mjs",
    "gen:theme": "node tools/gen_apple_color.mjs"
  }
}
